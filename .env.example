# ==============================================================================
# TOURMS WORKFORCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never store real production secrets or API keys in repository files.
# Public client variables in Vite MUST start with 'VITE_'.
# ==============================================================================

# Application URL & Domain
CUSTOM_DOMAIN="https://tourmsworkforce.com.ng"
APP_URL="http://localhost:3000"

# Firebase Client Configuration (Public variables for Web Browser)
# These fall back automatically to firebase-applet-config.json if not set.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Local Firebase Emulator Toggle (Set to 'true' to connect to local emulators)
VITE_USE_FIREBASE_EMULATOR="false"

# Third-Party SMS Gateway (SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# Live Termii integration is executed via backend Cloud Functions/webhooks only.
# TERMII_API_KEY="your_secret_termii_api_key_for_backend"
# TERMII_SENDER_ID="TOURMS"
